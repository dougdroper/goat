{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "goatman:goatman",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "goatman:mode": {
          "type": "enum",
          "values": ["roam", "stare", "chase"],
          "default": "roam",
          "client_sync": true
        }
      }
    },

    "component_groups": {
      "goatman:roaming": {
        "minecraft:collision_box": { "width": 0.7, "height": 2.9 },
        "minecraft:movement": { "value": 0.25 },
        "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
        "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 32, "probability": 0.4 },
        "minecraft:behavior.random_look_around": { "priority": 8 }
      },

      "goatman:staring": {
        "minecraft:collision_box": { "width": 0.7, "height": 2.9 },
        "minecraft:movement": { "value": 0 },
        "minecraft:behavior.look_at_player": {
          "priority": 0,
          "look_distance": 64,
          "probability": 1.0,
          "look_time": [400, 400]
        }
      },

      "goatman:hunting": {
        "minecraft:collision_box": { "width": 0.9, "height": 1.7 },
        "minecraft:movement": { "value": 0.33 },
        "minecraft:behavior.hurt_by_target": { "priority": 1 },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.3,
          "track_target": true,
          "reach_multiplier": 1.6
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 80,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "has_ability", "subject": "other", "value": "instabuild", "operator": "!=" }
                ]
              },
              "max_dist": 80
            }
          ]
        },
        "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 1.0 }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["goatman", "monster", "mob"] },
      "minecraft:health": { "value": 60, "max": 60 },
      "minecraft:attack": { "damage": 9 },
      "minecraft:knockback_resistance": { "value": 0.6 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:follow_range": { "value": 80, "max": 80 },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "can_open_doors": true,
        "can_pass_doors": true,
        "can_break_doors": true,
        "avoid_damage_blocks": true
      },
      "minecraft:annotation.break_door": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": {},
      "minecraft:despawn": {
        "despawn_from_distance": { "min_distance": 64, "max_distance": 128 }
      },
      "minecraft:ambient_sound_interval": { "value": 6, "range": 10, "event_name": "ambient" },
      "minecraft:behavior.float": { "priority": 0 }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["goatman:roaming"] },
        "set_property": { "goatman:mode": "roam" }
      },
      "goatman:roam": {
        "remove": { "component_groups": ["goatman:staring", "goatman:hunting"] },
        "add": { "component_groups": ["goatman:roaming"] },
        "set_property": { "goatman:mode": "roam" }
      },
      "goatman:stare": {
        "remove": { "component_groups": ["goatman:roaming", "goatman:hunting"] },
        "add": { "component_groups": ["goatman:staring"] },
        "set_property": { "goatman:mode": "stare" }
      },
      "goatman:hunt": {
        "remove": { "component_groups": ["goatman:roaming", "goatman:staring"] },
        "add": { "component_groups": ["goatman:hunting"] },
        "set_property": { "goatman:mode": "chase" }
      }
    }
  }
}
