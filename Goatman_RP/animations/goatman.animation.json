{
  "format_version": "1.8.0",
  "animations": {
    "animation.goatman.look_at_target": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0] }
      }
    },

    "animation.goatman.idle": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "math.sin(math.floor(query.life_time * 3) * 71.3) * 12",
            "math.sin(math.floor(query.life_time * 2) * 53.1) * 25",
            "math.sin(math.floor(query.life_time * 4) * 97.7) * 18"
          ]
        },
        "jaw": { "rotation": ["math.sin(query.life_time * 900) * 4", 0, 0] },
        "chest": { "rotation": ["math.sin(query.life_time * 90) * 2", 0, 0] },
        "leftArm": { "rotation": [0, 0, "-4 - math.sin(query.life_time * 50) * 3"] },
        "rightArm": { "rotation": [0, 0, "4 + math.sin(query.life_time * 50) * 3"] },
        "leftForearm": { "rotation": ["-12 + math.sin(math.floor(query.life_time * 5) * 33.3) * 8", 0, 0] },
        "rightForearm": { "rotation": ["-12 + math.sin(math.floor(query.life_time * 5) * 44.4) * 8", 0, 0] }
      }
    },

    "animation.goatman.walk": {
      "loop": true,
      "bones": {
        "leftThigh": { "rotation": ["math.cos(query.anim_time * 420) * 30", 0, 0] },
        "rightThigh": { "rotation": ["-math.cos(query.anim_time * 420) * 30", 0, 0] },
        "leftShin": { "rotation": ["math.max(0, math.sin(query.anim_time * 420)) * 25", 0, 0] },
        "rightShin": { "rotation": ["math.max(0, -math.sin(query.anim_time * 420)) * 25", 0, 0] },
        "leftArm": { "rotation": ["-math.cos(query.anim_time * 420) * 22", 0, 0] },
        "rightArm": { "rotation": ["math.cos(query.anim_time * 420) * 22", 0, 0] },
        "body": {
          "rotation": [8, 0, "math.sin(query.anim_time * 210) * 4"],
          "position": [0, "math.abs(math.sin(query.anim_time * 420)) * 0.8", 0]
        }
      }
    },

    "animation.goatman.stare": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            0,
            0,
            "math.sin(math.floor(query.anim_time * 1.3) * 41.7) > 0.3 ? math.sin(math.floor(query.anim_time * 1.3) * 13.3) * 40 : 0"
          ]
        },
        "jaw": { "rotation": ["math.min(query.anim_time * 3, 30) + math.sin(query.anim_time * 1400) * 1.5", 0, 0] },
        "chest": { "rotation": ["-8 + math.sin(query.anim_time * 120) * 2.5", 0, 0] },
        "leftArm": { "rotation": [0, 0, -6] },
        "rightArm": { "rotation": [0, 0, 6] },
        "leftForearm": { "rotation": ["-20 + math.sin(math.floor(query.anim_time * 9) * 12.9) * 10", 0, 0] },
        "rightForearm": { "rotation": ["-20 + math.sin(math.floor(query.anim_time * 9) * 77.1) * 10", 0, 0] }
      }
    },

    "animation.goatman.quad_pose": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [70, "math.sin(math.floor(query.life_time * 6) * 33.3) * 10", 0],
          "position": [0, -2, 0]
        },
        "leftArm": { "rotation": [-85, 0, -8] },
        "rightArm": { "rotation": [-85, 0, 8] },
        "head": {
          "rotation": [
            "-70 + math.sin(math.floor(query.life_time * 8) * 61.1) * 15",
            "math.sin(math.floor(query.life_time * 7) * 29.9) * 22",
            "math.sin(math.floor(query.life_time * 9) * 77.7) * 28"
          ]
        },
        "jaw": { "rotation": ["15 + math.sin(query.life_time * 1500) * 8", 0, 0] }
      }
    },

    "animation.goatman.quad_run": {
      "loop": true,
      "bones": {
        "leftArm": { "rotation": ["math.cos(query.anim_time * 720) * 40", 0, 0] },
        "rightArm": { "rotation": ["math.cos(query.anim_time * 720 + 60) * 40", 0, 0] },
        "leftForearm": { "rotation": ["math.min(0, math.sin(query.anim_time * 720)) * 35", 0, 0] },
        "rightForearm": { "rotation": ["math.min(0, math.sin(query.anim_time * 720 + 60)) * 35", 0, 0] },
        "leftThigh": { "rotation": ["math.cos(query.anim_time * 720 + 180) * 35", 0, 0] },
        "rightThigh": { "rotation": ["math.cos(query.anim_time * 720 + 240) * 35", 0, 0] },
        "leftShin": { "rotation": ["math.max(0, math.sin(query.anim_time * 720 + 180)) * 30", 0, 0] },
        "rightShin": { "rotation": ["math.max(0, math.sin(query.anim_time * 720 + 240)) * 30", 0, 0] },
        "body": {
          "rotation": ["math.sin(query.anim_time * 1440) * 6", 0, 0],
          "position": [0, "math.abs(math.sin(query.anim_time * 720)) * 1.5", 0]
        }
      }
    }
  }
}
