{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.goatman.pose": {
      "initial_state": "roam",
      "states": {
        "roam": {
          "animations": ["idle", "look_at_target", { "walk": "query.modified_move_speed" }],
          "transitions": [
            { "stare": "query.property('goatman:mode') == 'stare'" },
            { "chase": "query.property('goatman:mode') == 'chase'" }
          ],
          "blend_transition": 0.3
        },
        "stare": {
          "animations": ["stare", "look_at_target"],
          "transitions": [
            { "chase": "query.property('goatman:mode') == 'chase'" },
            { "roam": "query.property('goatman:mode') == 'roam'" }
          ],
          "blend_transition": 0.4
        },
        "chase": {
          "animations": ["quad_pose", { "quad_run": "math.clamp(query.modified_move_speed * 1.5, 0, 1)" }],
          "transitions": [
            { "roam": "query.property('goatman:mode') == 'roam'" },
            { "stare": "query.property('goatman:mode') == 'stare'" }
          ],
          "blend_transition": 0.25
        }
      }
    }
  }
}
